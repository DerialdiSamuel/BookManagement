@model IEnumerable<BookManagement.Models.Buku>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Judul)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Penulis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JenisBuku)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TanggalRilis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JumlahHalaman)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JenisBukuNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Judul)
            </td>
            <td>
                @Html.DisplayFor(model => item.Penulis)
            </td>
            <td>
                @Html.DisplayFor(model => item.JenisBuku)
            </td>
            <td>
                @Html.DisplayFor(model => item.TanggalRilis)
            </td>
            <td>
                @Html.DisplayFor(model => item.JumlahHalaman)
            </td>
            <td>
                @Html.DisplayFor(model => item.JenisBukuNavigation)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
